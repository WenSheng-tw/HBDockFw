/*
 * hbdock.ch
 *
 * Constantes Harbour para HBDock32. Los valores coinciden
 * exactamente con el enum HB_DOCK_SITE de hbdockdocksite.h
 * -- no cambiar sin actualizar ambos lados.
 */

#ifndef HBDOCK_CH
#define HBDOCK_CH

#define HBDOCK_NONE      0
#define HBDOCK_LEFT      1
#define HBDOCK_RIGHT     2
#define HBDOCK_TOP       3
#define HBDOCK_BOTTOM    4
#define HBDOCK_CENTER    5

#endif
